{
  "name": "sales-reimbursement-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --config config/prisma.config.ts && node scripts/fix-prisma-mjs.js",
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "clean": "rimraf .next",
    "lint": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config config/prisma.config.ts && node scripts/fix-prisma-mjs.js",
    "db:migrate": "prisma migrate deploy --config config/prisma.config.ts",
    "db:status": "prisma migrate status --config config/prisma.config.ts",
    "db:studio": "prisma studio --config config/prisma.config.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:clean": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.2",
    "@notionhq/client": "^5.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "jspdf": "^4.2.1",
    "next": "^16.3.7",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
